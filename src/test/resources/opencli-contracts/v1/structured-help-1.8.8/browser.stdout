{
  "namespace": "browser",
  "command": "opencli browser",
  "usage": "opencli browser <session> <command> [options]",
  "description": "Browser control — navigate, click, type, extract, wait (no LLM needed)",
  "command_count": 42,
  "commands": [
    {
      "name": "analyze",
      "command": "opencli browser <session> analyze",
      "usage": "opencli browser <session> analyze <url> [options]",
      "description": "Classify site: anti-bot vendor, real-data API candidates, pattern (A/B/C/D), nearest adapter, next step",
      "positionals": [
        {
          "name": "url",
          "required": true
        }
      ],
      "command_options": [
        {
          "name": "tab",
          "flags": "--tab <targetId>",
          "help": "Target tab/page identity returned by \"browser open\", \"browser tab new\", or \"browser tab list\"",
          "takes_value": "required"
        }
      ]
    },
